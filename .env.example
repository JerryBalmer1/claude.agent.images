# .env.example — the contract. COMMITTED. Every value here is empty or non-secret.
#
# Copy this to .env.local and paste real values there, or just run
#   pwsh -NoProfile -File scripts/env.ps1 -Check
# which creates .env.local from this file if it is missing.
#
# .env.local is gitignored and must never be committed. Never paste a real value
# into a chat — a token in a chat log is burned and must be revoked.
# See docs/skills/secret-hygiene.md.

# GitHub fine-grained PAT, name it "claude-build-terraform". Scope it to the six
# claude.* repos only — not "all repositories".
# Permissions: Administration rw, Contents r, Metadata r, Actions rw, Secrets rw,
# Workflows rw (only if the mirror is enabled); account: Git SSH signing keys rw.
# Expiry: 90 days. Create at
# github.com > Settings > Developer settings > Personal access tokens > Fine-grained.
# Read by: terraform (GITHUB_TOKEN), .build.ps1 -Task Keys, .build.ps1 -Task Verify
GITHUB_TOKEN=
# The GitHub account the six repos live under. Not a secret.
# Read by: terraform (TF_VAR_owner)
TF_VAR_owner=JerryBalmer1
# Optional. The account or org that holds the mirror repos.
# Leave empty to disable the mirror entirely.
# Read by: terraform (TF_VAR_mirror_owner)
TF_VAR_mirror_owner=
# Optional. Private half of the mirror deploy key, generated by
# `.build.ps1 -Task Keys -Mirror`. Leave empty unless the mirror is on.
# Read by: terraform (TF_VAR_mirror_deploy_key)
TF_VAR_mirror_deploy_key=
# Folder holding the four actor signing keys. Not a secret — it is a path.
# Read by: .build.ps1 -Task Keys, .build.ps1 -Task As
CLAUDE_BUILD_KEYS=~/.ssh/claude.build
