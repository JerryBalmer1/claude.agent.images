{
  "allowManagedHooksOnly": true,
  "disableBypassPermissionsMode": true,
  "permissions": {
    "allow": [],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File /opt/leash/hooks/sentinel.ps1 -Mode Observe",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
