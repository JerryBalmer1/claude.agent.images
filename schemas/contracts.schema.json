{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SiblingContracts",
  "description": "The surface the claude.build siblings share. They do not share code; they share this. Every row states what it consumes, what it emits, what it gates, and how well that is known.",
  "type": "object",
  "required": ["schema", "generated", "siblings", "exceptions"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "claude.build.contracts/1" },
    "generated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "source": { "type": "string" },
    "siblings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "consumes", "emits", "gates"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["policy", "sentinel", "ledger", "inspector", "fuzzer"] },
          "status": {
            "enum": ["known", "known-but-split", "pending-exports", "proposed"],
            "description": "known = proven from files in this repo. known-but-split = proven, but the same fact lives in more than one place. pending-exports = the module does not export what this row would need. proposed = does not exist here yet."
          },
          "consumes": { "type": "array", "items": { "type": "string" } },
          "emits": { "type": "array", "items": { "type": "string" } },
          "gates": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "statement": { "type": "string" },
          "status": { "enum": ["accepted", "unproven", "blocker"] },
          "blocker": { "type": "string", "pattern": "^BLOCKER-[0-9]+$" },
          "evidence": { "type": "string" }
        }
      }
    }
  }
}
